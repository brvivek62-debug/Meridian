# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- NEAR (testnet) ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
OWNER_ACCOUNT_ID=your-owner.testnet
VAULT_CONTRACT_ID=vault.your-owner.testnet

# Demo accounts created by `npm run deploy` as sub-accounts of the owner.
# Their private keys are NOT kept here: they live in ~/.near-credentials/testnet/<account>.json.
# The owner key stays in the near-cli-rs keychain.
AGENT_ACCOUNT_ID=agent.your-owner.testnet
PAID_API_ACCOUNT_ID=paid-api.your-owner.testnet
WORKER_SCRAPER_ACCOUNT_ID=worker-scraper.your-owner.testnet
WORKER_SUMMARIZER_ACCOUNT_ID=worker-summarizer.your-owner.testnet

# --- LLM: NEAR AI Cloud (OpenAI-compatible) ---
# Verify base URL and model name at https://docs.near.ai/
NEARAI_API_KEY=REPLACE_ME
NEARAI_BASE_URL=REPLACE_WITH_BASE_URL_FROM_NEAR_AI_DOCS
LLM_MODEL=REPLACE_WITH_TOOL_CALLING_MODEL

# --- Chain Signatures (Ethereum Sepolia) ---
MPC_CONTRACT_ID=v1.signer-prod.testnet
SEPOLIA_RPC_URL=REPLACE_ME

# --- NEAR Intents (1Click API, mainnet) ---
ONECLICK_API_URL=https://1click.chaindefuser.com
ONECLICK_JWT=

# --- Dashboard ---
DEMO_MODE=true
