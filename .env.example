# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- NEAR (testnet) ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
OWNER_ACCOUNT_ID=your-owner.testnet
VAULT_CONTRACT_ID=your-vault.testnet

# Agent account: holds ONLY a function-call key restricted to the Vault
AGENT_ACCOUNT_ID=your-agent.testnet
AGENT_PRIVATE_KEY=ed25519:REPLACE_ME

# Vendor / worker accounts
PAID_API_ACCOUNT_ID=your-paid-api.testnet
WORKER_SCRAPER_ACCOUNT_ID=your-scraper.testnet
WORKER_SCRAPER_PRIVATE_KEY=ed25519:REPLACE_ME
WORKER_SUMMARIZER_ACCOUNT_ID=your-summarizer.testnet
WORKER_SUMMARIZER_PRIVATE_KEY=ed25519:REPLACE_ME

# --- LLM: NEAR AI Cloud (OpenAI-compatible) ---
# Verify base URL and model name at https://docs.near.ai/
NEARAI_API_KEY=REPLACE_ME
NEARAI_BASE_URL=REPLACE_WITH_BASE_URL_FROM_NEAR_AI_DOCS
LLM_MODEL=REPLACE_WITH_TOOL_CALLING_MODEL

# --- Chain Signatures (Ethereum Sepolia) ---
MPC_CONTRACT_ID=v1.signer-prod.testnet
SEPOLIA_RPC_URL=REPLACE_ME

# --- NEAR Intents (1Click API, mainnet) ---
ONECLICK_API_URL=https://1click.chaindefuser.com
ONECLICK_JWT=

# --- Dashboard ---
DEMO_MODE=true
