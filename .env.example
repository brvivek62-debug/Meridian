# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- NEAR (testnet) ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
# Used by dashboard/lib/near.ts's FailoverRpcProvider when the primary RPC errors or rate-limits.
NEAR_RPC_URL_FALLBACK=https://rpc.testnet.near.org
OWNER_ACCOUNT_ID=your-owner.testnet
VAULT_CONTRACT_ID=vault.your-owner.testnet

# Demo accounts created by `npm run deploy` as sub-accounts of the owner.
# Their private keys are NOT kept here: they live in ~/.near-credentials/testnet/<account>.json.
# The owner key stays in the near-cli-rs keychain.
AGENT_ACCOUNT_ID=agent.your-owner.testnet
PAID_API_ACCOUNT_ID=paid-api.your-owner.testnet
WORKER_SCRAPER_ACCOUNT_ID=worker-scraper.your-owner.testnet
WORKER_SUMMARIZER_ACCOUNT_ID=worker-summarizer.your-owner.testnet

# --- dashboard/ demo-owner account (M7) ---
# Created by `npm run setup-dashboard`. Unlike the accounts above, its key is
# kept HERE (not ~/.near-credentials) so the dashboard's Next.js server can
# read it — still server-side only, never sent to the browser. It signs owner
# actions (create mandate, approve, reject) for the dashboard's own sandbox
# mandates only; the real owner's keychain key is never used by the dashboard.
DEMO_OWNER_ACCOUNT_ID=demo-owner.your-owner.testnet
DEMO_OWNER_PRIVATE_KEY=REPLACE_ME

# --- "Break Meridian" public challenge (/break) ---
# Created by `npm run setup-break-agent`: its own account, mandate (small
# budget/caps, allowlist = paid-api only) and restricted key — isolated from
# every other mandate so public attempts can't drain or interfere with them.
BREAK_AGENT_ACCOUNT_ID=break-agent.your-owner.testnet
BREAK_MANDATE_ID=0
# Kill switch: set to "false" to take the challenge offline instantly.
BREAK_ENABLED=true
# Cheapest NEAR AI Cloud model confirmed (GET /v1/models) to support "tools".
BREAK_MODEL=openai/gpt-5-nano
# Only needed on a serverless deploy (e.g. Vercel), which has no
# ~/.near-credentials to read break-agent's key from. Local dev leaves this
# blank and uses the credentials file written by setup-break-agent.ts.
BREAK_AGENT_PRIVATE_KEY=

# --- Hosted /break storage (Vercel deploy only) ---
# Upstash Redis via the Vercel Marketplace integration: attempts, scoreboard
# and rate limits move off the local JSON file / in-memory counters, which
# don't work across serverless instances. Leave both blank for local dev —
# dashboard/lib/breakStore.ts falls back to the JSON file automatically. The
# integration may write either this pair or the legacy KV_REST_API_URL/TOKEN
# names; either works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- LLM: NEAR AI Cloud (OpenAI-compatible) ---
# Verified at https://docs.near.ai/cloud/guides/openai-compatibility.md and against
# the live GET /v1/models (supported_features includes "tools"). Get a key at
# https://cloud.near.ai/dashboard.
NEARAI_API_KEY=REPLACE_ME
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
LLM_MODEL=z-ai/glm-5.3-flash

# --- vendors/paid-api ---
PAID_API_PORT=4021
PAID_API_URL=http://localhost:4021
PAID_API_PRICE_NEAR=0.3

# --- vendors/worker-scraper, vendors/worker-summarizer (M6) ---
WORKER_SCRAPER_PORT=4031
WORKER_SCRAPER_URL=http://localhost:4031
WORKER_SUMMARIZER_PORT=4032
WORKER_SUMMARIZER_URL=http://localhost:4032

# --- Chain Signatures (Ethereum Sepolia) ---
MPC_CONTRACT_ID=v1.signer-prod.testnet
SEPOLIA_RPC_URL=REPLACE_ME

# --- NEAR Intents (1Click API, mainnet) ---
ONECLICK_API_URL=https://1click.chaindefuser.com
ONECLICK_JWT=

# --- Dashboard ---
DEMO_MODE=true
