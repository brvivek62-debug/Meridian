{
  "name": "meridian",
  "private": true,
  "type": "module",
  "description": "Meridian: delegated, policy-checked spending for AI agents on NEAR",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "deploy": "tsx scripts/deploy.ts",
    "seed": "tsx scripts/seed.ts",
    "setup-dashboard": "tsx scripts/setup-dashboard.ts",
    "setup-agent-key": "tsx scripts/setup-agent-key.ts",
    "setup-worker-keys": "tsx scripts/setup-worker-keys.ts",
    "setup-break-agent": "tsx scripts/setup-break-agent.ts",
    "prove-no-bypass": "tsx scripts/prove-key-restriction.ts",
    "paid-api": "tsx vendors/paid-api/src/index.ts",
    "worker-scraper": "tsx vendors/worker-scraper/src/index.ts",
    "worker-summarizer": "tsx vendors/worker-summarizer/src/index.ts",
    "agent": "tsx agent/src/index.ts",
    "agent:m6": "tsx agent/src/index.ts --m6",
    "demo:m5": "tsx scripts/demo-m5.ts",
    "demo:m6": "tsx scripts/demo-m6.ts",
    "dashboard": "npm --prefix dashboard run dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "near-api-js": "7.4.0",
    "openai": "7.55.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
